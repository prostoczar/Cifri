VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Analytics. Both are client-side values and are safe to expose in the bundle — the project
# token identifies which PostHog project to write to, and grants nothing else. Leaving them
# unset disables analytics entirely, which is what a contributor's checkout should do.
VITE_POSTHOG_KEY=phc_your-project-token
VITE_POSTHOG_HOST=https://eu.i.posthog.com
